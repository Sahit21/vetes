{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/leitfaden/dateien/(.*)\\.json",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/b/:code",
      "destination": "https://n8n.ssahit.de/webhook/qr?c=:code"
    },
    {
      "source": "/qr-dashboard",
      "destination": "https://n8n.ssahit.de/webhook/qr-dashboard"
    }
  ]
}
